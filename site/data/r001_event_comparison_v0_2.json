    "rising_absolute_3q": "q0 > q1 > q2 among last 3 released quarters (not equivalent to accelerating growth)",
    "growth_accelerating_3q": "g_yoy_q0 > g_yoy_q1 > g_yoy_q2 (three sequential growth-rate points); zero acceleration at latest disqualifies",
    "roic_ttm_pct": "100 * TTM NOPAT / average invested capital; denominator/corporate-action and accounting adjustment needed; null until verified",
    "roe_ttm_pct": "100 * TTM net income / average common equity (needs verified two dated balance sheets)",
    "roa_ttm_pct": "100 * TTM net income / average total assets (needs verified two dated balance sheets)",
